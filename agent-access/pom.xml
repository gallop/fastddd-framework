<?xml version="1.0" encoding="UTF-8"?>
<!--
  FastDDD Agent Access 独立聚合 reactor（AA-04 MC-2 / MC-3）

  边界（冻结决策，不得违反）：
  - 不加入 FastDDD 根 POM <modules>；主线 reactor/BOM/enforcer/既有生产代码零改动
  - 版本为字面量（主线 ${revision} CI-friendly 机制不适用于本 experimental 线）
  - 四版本轴（AA-04 §2.2）：制品 0.1.0-jdk21-alpha.1 / 契约文档 fastddd-agent-access/0.1
    / wire schemaVersion "0.1" / digestSchemaVersion 1 —— 互不推导
  - bom 模块（fastddd-agent-access-bom）为 FDD-AA-16 落点，本骨架不含
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.gallop.fastddd</groupId>
  <artifactId>fastddd-agent-access-parent</artifactId>
  <version>0.1.0-jdk21-alpha.1</version>
  <packaging>pom</packaging>

  <name>FastDDD Agent Access (experimental line)</name>
  <description>FastDDD Agent Access Phase 1A — governed agent entry seam (ADR-006/ADR-007, Contract fastddd-agent-access/0.1)</description>
  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <organization>
    <name>gallop-group</name>
  </organization>
  <developers>
    <developer>
      <id>gallop</id>
      <name>Gallop</name>
      <email>39100782@qq.com</email>
    </developer>
  </developers>

  <modules>
    <module>fastddd-agent-access</module>
    <module>fastddd-agent-access-contract-kit</module>
    <!-- FDD-AA-16：BOM 进默认 reactor（发布面；AA-04 §3.1 三模块收齐） -->
    <module>fastddd-agent-access-bom</module>
  </modules>

  <!--
    carrier-conformance profile（FDD-AA-13 收口，2026-08-16）：

    真实 V04-04 carrier 消费模块（fastddd-agent-access-carrier-conformance）的显式门控入口。
    Phase baseline §7 FDD-AA-13 原文约束「必须消费 V04-04 的真实 dispatch contract artifact，
    在真实 carrier 通过前不得完成」——该模块 test scope 从 Maven 坐标消费
    com.gallop.fastagent:fastagent-fastddd-command-adapter（本地仓 D-2 形态，与 FastAgent 侧
    T34 conformance 互为镜像），与 banned-dependencies 的 L3 制品独立性边界（AA-04 §3.3 /
    ADR-007）冲突，故：
    - 默认 reactor 不含本模块（无 FastAgent 制品可解析的环境不阻断构建）；
    - 激活（-Pcarrier-conformance）时子模块以显式 skip 豁免继承的 enforcer 执行并注明依据；
    - 主制品与 kit 的「零 FastAgent 依赖」不受影响（发布面不变）。
  -->
  <profiles>
    <profile>
      <id>carrier-conformance</id>
      <activation>
        <activeByDefault>false</activeByDefault>
      </activation>
      <modules>
        <module>fastddd-agent-access-carrier-conformance</module>
      </modules>
    </profile>
  </profiles>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>${java.version}</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <!-- 与 FastDDD 主线对齐（根 POM spring-boot.version=3.5.16） -->
    <spring-boot.version>3.5.16</spring-boot.version>
    <maven-enforcer-plugin.version>3.4.1</maven-enforcer-plugin.version>
    <maven-resources-plugin.version>3.3.1</maven-resources-plugin.version>
    <maven-surefire-plugin.version>3.2.5</maven-surefire-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.gallop.fastddd</groupId>
        <artifactId>fastddd-agent-access</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>${maven-resources-plugin.version}</version>
        <executions>
          <execution>
            <id>include-community-legal-files</id>
            <phase>process-resources</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/META-INF</outputDirectory>
              <resources>
                <resource>
                  <directory>${maven.multiModuleProjectDirectory}/agent-access</directory>
                  <filtering>false</filtering>
                  <includes>
                    <include>LICENSE</include>
                    <include>NOTICE</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- AA-04 §3.3 禁止依赖清单的构建期断言（骨架期关键集；完整清单 FDD-AA-15 扩充） -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${maven-enforcer-plugin.version}</version>
        <executions>
          <execution>
            <id>agent-access-banned-dependencies</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <!-- L3 边界：两侧 core 互不依赖（ADR-007） -->
                    <exclude>com.gallop.fastagent:*</exclude>
                    <!-- MC-4：禁 fast-ddd-starter（自动配置/主线装配语义） -->
                    <exclude>com.gallop.fastddd:fast-ddd-starter</exclude>
                    <!-- MC-4：禁 LLM SDK / MCP / Spring AI -->
                    <exclude>dev.langchain4j:*</exclude>
                    <exclude>io.modelcontextprotocol:*</exclude>
                    <exclude>org.springframework.ai:*</exclude>
                  </excludes>
                  <message>agent-access 禁止依赖（AA-04 §3.3 / ADR-007）：FastAgent、fast-ddd-starter、LLM/MCP/Spring AI 均不允许出现在本 reactor 依赖树中</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
