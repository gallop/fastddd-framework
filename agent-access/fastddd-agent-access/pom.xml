<?xml version="1.0" encoding="UTF-8"?>
<!--
  fastddd-agent-access 主制品（AA-04 §3.2 五包中的 .contract/.spi 于 FDD-AA-10 建立；
  .permit/.gateway/.arch 分别由 FDD-AA-11/12 落地）

  依赖约束：.contract 仅 JDK；.spi 仅依赖 .contract。
  对 FastDDD 主线唯一允许的 compile 接缝是 fast-ddd-application（FDD-AA-12 编排需要时引入，
  本模块当前不需要）。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.gallop.fastddd</groupId>
    <artifactId>fastddd-agent-access-parent</artifactId>
    <version>0.1.0-jdk21-alpha.1</version>
  </parent>

  <artifactId>fastddd-agent-access</artifactId>
  <packaging>jar</packaging>

  <name>FastDDD Agent Access Core</name>

  <!-- 纯 JDK 模块：协议 DTO 与 SPI，无任何 compile 依赖（AA-04 §3.2） -->
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
