<?xml version="1.0" encoding="UTF-8"?>
<!-- ECO-006C6 验收消费者：fast-ddd-event 默认 local 无库契约——无 H2、无数据源配置、
     无自动配置排除、无显式 mode。与 event-minimal 的唯一差异 = 删除 exclude 与 mode 配置，
     验证"开箱默认"形态（C5 F1：修复前该形态 3/3 启动失败，MP starter→Hikari 急切建池）。
     本场景即 C5 探针 event-nodb-probe 收编为正式回归门禁。 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>
  <groupId>com.gallop.fastddd.consumer</groupId>
  <artifactId>event-nodb</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <name>FastDDD Consumer :: Event No-DB Default Contract</name>

  <properties>
    <java.version>21</java.version>
    <fastddd.version>1.0.0-jdk21-SNAPSHOT</fastddd.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.gallop.fastddd</groupId>
        <artifactId>fastddd-bom</artifactId>
        <version>${fastddd.version}</version>
        <type>pom</type><scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>com.gallop.fastddd</groupId>
      <artifactId>fast-ddd-event</artifactId>
    </dependency>
    <!-- 故意不引入 H2/JDBC/DataSource，也不写任何 application.yml：
         ECO-006C6 验收"无库、无排除、无显式 mode"的开箱默认契约 -->
    <dependency>
      <groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope>
    </dependency>
  </dependencies>
</project>
