<?xml version="1.0" encoding="UTF-8"?>
<!-- W2-2（§六 D / §七）：飞书浏览器登录闭环消费者——真实 fast-ddd-identity-feishu 适配器
     （authorizeUrl + token v3 + user_info）经 BOM 解析本地安装制品；飞书侧为本地 HTTP 桩
     （§五 桩边界：桩仅存在于测试夹具，不进生产代码；桩通过 ≠ 真实飞书联调通过）。 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>
  <groupId>com.gallop.fastddd.consumer</groupId>
  <artifactId>identity-feishu-login</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <name>FastDDD Consumer :: Identity Feishu Login (browser loop)</name>

  <properties>
    <java.version>21</java.version>
    <fastddd.version>1.0.0-SNAPSHOT</fastddd.version>
    <!-- ECO-RELEASE-04/S3 安全覆盖：tomcat-embed CVE-2026-65905/65182/68525（3×CRITICAL，10.1.x 线 fix 实际发布 10.1.59）。 -->
    <tomcat.version>10.1.59</tomcat.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.github.gallop.fastddd</groupId>
        <artifactId>fastddd-bom</artifactId>
        <version>${fastddd.version}</version>
        <type>pom</type><scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>io.github.gallop.fastddd</groupId>
      <artifactId>fast-ddd-identity-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.gallop.fastddd</groupId>
      <artifactId>fast-ddd-identity-reference-pg</artifactId>
    </dependency>
    <!-- W2-2 新模块：真实飞书适配器（ExternalLoginProvider + ExternalAuthorizePort） -->
    <dependency>
      <groupId>io.github.gallop.fastddd</groupId>
      <artifactId>fast-ddd-identity-feishu</artifactId>
    </dependency>
    <!-- 宿主旧安全装配显式退让（jwt/local-auth=false）后仍留在 classpath（与 C 模式宿主同构） -->
    <dependency>
      <groupId>io.github.gallop.fastddd</groupId>
      <artifactId>fast-ddd-security-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.gallop.fastddd</groupId>
      <artifactId>fast-ddd-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId><artifactId>spring-security-test</artifactId><scope>test</scope>
    </dependency>
    <!-- 真实 PG 门禁（§七）：zonky 一次性测试库，不用 H2/内存桩替代 -->
    <dependency>
      <groupId>io.zonky.test</groupId><artifactId>embedded-postgres</artifactId><version>2.0.7</version><scope>test</scope>
    </dependency>
  </dependencies>
</project>
