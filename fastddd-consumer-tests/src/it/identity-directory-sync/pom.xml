<?xml version="1.0" encoding="UTF-8"?>
<!-- W3-c 目录同步消费者：directory.enabled=true 下经真实 Boot 装配真实
     PgDirectoryMirrorStore（reference-pg，zonky 一次性 PG）+ 真实 DirectorySyncUseCase
     编排，完整发布链落真实库并做行级断言；W3-c 组件（手动触发 §9.4/差异报表 §6.6）
     消费真实存储；矩阵 25：directory.enabled=false 复验目录关闭登录零回归
     （登录/T2/停用路径与 W2-2 基线一致）。源与登录/准入/授权 URL 桩均为测试夹具
     （§五 桩边界）；真实飞书源见 identity-directory-feishu 场景。 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>
  <groupId>com.gallop.fastddd.consumer</groupId>
  <artifactId>identity-directory-sync</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <name>FastDDD Consumer :: Identity Directory Sync (W3-c)</name>

  <properties>
    <java.version>21</java.version>
    <fastddd.version>1.1.0-SNAPSHOT</fastddd.version>
    <!-- ECO-RELEASE-04/S3 安全覆盖：tomcat-embed CVE-2026-65905/65182/68525（3×CRITICAL，10.1.x 线 fix 实际发布 10.1.59）。 -->
    <tomcat.version>10.1.59</tomcat.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.github.gallop.fastddd</groupId>
        <artifactId>fastddd-bom</artifactId>
        <version>${fastddd.version}</version>
        <type>pom</type><scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>io.github.gallop.fastddd</groupId>
      <artifactId>fast-ddd-identity-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.gallop.fastddd</groupId>
      <artifactId>fast-ddd-identity-reference-pg</artifactId>
    </dependency>
    <!-- C 前提：宿主旧安全装配显式退让（jwt/local-auth=false）后仍留在 classpath -->
    <dependency>
      <groupId>io.github.gallop.fastddd</groupId>
      <artifactId>fast-ddd-security-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.gallop.fastddd</groupId>
      <artifactId>fast-ddd-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope>
    </dependency>
    <!-- 真实 PG 门禁（§七）：zonky 一次性测试库，不用 H2/内存桩替代 -->
    <dependency>
      <groupId>io.zonky.test</groupId><artifactId>embedded-postgres</artifactId><version>2.0.7</version><scope>test</scope>
    </dependency>
  </dependencies>
</project>
