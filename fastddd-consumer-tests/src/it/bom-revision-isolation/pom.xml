<?xml version="1.0" encoding="UTF-8"?>
<!--
  ECO-003：消费项目自己的 revision 必须不能覆盖 Framework BOM 内部模块版本。
  本项目故意把 revision 设置为一个不存在的消费者版本；如果 BOM 使用 ${revision}
  管理 fast-ddd-*，compile 会错误解析 9.9.9-consumer-SNAPSHOT 并失败。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.gallop.fastddd.consumer</groupId>
  <artifactId>bom-revision-isolation</artifactId>
  <version>${revision}</version>

  <properties>
    <revision>9.9.9-consumer-SNAPSHOT</revision>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <fastddd.version>1.1.0-SNAPSHOT</fastddd.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.github.gallop.fastddd</groupId>
        <artifactId>fastddd-bom</artifactId>
        <version>${fastddd.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>io.github.gallop.fastddd</groupId>
      <artifactId>fast-ddd-common</artifactId>
    </dependency>
  </dependencies>
</project>
