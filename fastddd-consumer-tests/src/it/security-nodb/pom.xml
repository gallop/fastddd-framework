<?xml version="1.0" encoding="UTF-8"?>
<!-- ECO-006C2：Security 无数据库消费者（无 H2、无 spring.datasource.*、无任何自动配置排除）。
     依赖仅 fast-ddd-security-starter：断言上下文无 DataSource/JdbcTemplate Bean、
     真实默认 SecurityFilterChain/JWT Filter/TokenProvider 行为（未认证 401、有效 token 200、
     权限不足 403，全部走 MockMvc 真实链，不用 @WithMockUser/自定义链/关闭 filters），
     以及无库审计按既有契约回退 SLF4J（AuditLogServiceImpl#logToSlf4j，非数据库持久化）。 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>
  <groupId>com.gallop.fastddd.consumer</groupId>
  <artifactId>security-nodb</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <name>FastDDD Consumer :: Security No-Database</name>

  <properties>
    <java.version>21</java.version>
    <fastddd.version>1.0.0-jdk21-SNAPSHOT</fastddd.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.gallop.fastddd</groupId>
        <artifactId>fastddd-bom</artifactId>
        <version>${fastddd.version}</version>
        <type>pom</type><scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>com.gallop.fastddd</groupId>
      <artifactId>fast-ddd-security-starter</artifactId>
    </dependency>
    <!-- 刻意不引入 H2 / spring-boot-starter-jdbc / 连接池：本场景就是"无数据库"契约本身 -->
    <dependency>
      <groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope>
    </dependency>
  </dependencies>
</project>
