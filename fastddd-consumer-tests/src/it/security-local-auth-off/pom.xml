<?xml version="1.0" encoding="UTF-8"?>
<!-- W1（评审 R1/§4.5）：显式关闭本地认证族的消费者（H2 + 默认 JWT + fast-ddd-web 在 classpath）。
     ApiResponse 在 classpath 使 AuthController/VerificationCodeController 在 local-auth=true 时*会*装配，
     据此断言 local-auth=false 下控制器/策略/默认用户名服务不装配、/api/auth/** 无路由映射，
     同时 JWT 验证链与 CurrentUserProvider 桥接不受影响（401/200 探针走真实默认链）。 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>
  <groupId>com.gallop.fastddd.consumer</groupId>
  <artifactId>security-local-auth-off</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <name>FastDDD Consumer :: Security Local-Auth Off (preset)</name>

  <properties>
    <java.version>21</java.version>
    <fastddd.version>1.1.0-SNAPSHOT</fastddd.version>
    <!-- ECO-RELEASE-04/S3 安全覆盖：tomcat-embed CVE-2026-65905/65182/68525（3×CRITICAL，10.1.x 线 fix 实际发布 10.1.59）。 -->
    <tomcat.version>10.1.59</tomcat.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.github.gallop.fastddd</groupId>
        <artifactId>fastddd-bom</artifactId>
        <version>${fastddd.version}</version>
        <type>pom</type><scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>io.github.gallop.fastddd</groupId>
      <artifactId>fast-ddd-security-starter</artifactId>
    </dependency>
    <!-- 与 security-minimal 的关键差异：引入 web（连带 crud/H2 域），使控制器类路径条件成立 -->
    <dependency>
      <groupId>io.github.gallop.fastddd</groupId>
      <artifactId>fast-ddd-web</artifactId>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId><artifactId>h2</artifactId><scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope>
    </dependency>
  </dependencies>
</project>
