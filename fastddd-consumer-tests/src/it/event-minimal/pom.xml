<?xml version="1.0" encoding="UTF-8"?>
<!-- EVT-001 验收消费者：fast-ddd-event local 模式（无 DataSource、无 MyBatis 活跃）可启动并发布事件，零 Outbox Bean。 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>
  <groupId>com.gallop.fastddd.consumer</groupId>
  <artifactId>event-minimal</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <name>FastDDD Consumer :: Event Minimal (local mode)</name>

  <properties>
    <java.version>21</java.version>
    <fastddd.version>1.0.0-SNAPSHOT</fastddd.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.github.gallop.fastddd</groupId>
        <artifactId>fastddd-bom</artifactId>
        <version>${fastddd.version}</version>
        <type>pom</type><scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>io.github.gallop.fastddd</groupId>
      <artifactId>fast-ddd-event</artifactId>
    </dependency>
    <!-- 故意不引入 H2/DataSource：EVT-001 验收 local 模式无数据库可启动 -->
    <dependency>
      <groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope>
    </dependency>
  </dependencies>
</project>
