<?xml version="1.0" encoding="UTF-8"?>
<!--
  ECO-006C4 验证点③：聚合 starter + 数据库——默认池仍为 Druid，既有功能不退化。
  真实外部消费者形态：parent=spring-boot-starter-parent，import fastddd-bom。
  不显式引入任何连接池：Druid 由 fast-ddd-starter 聚合显式携带（"引入即含默认池"）。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>
  <groupId>com.gallop.fastddd.consumer</groupId>
  <artifactId>starter-default-druid</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <name>FastDDD Consumer :: Starter Default Druid</name>

  <properties>
    <java.version>21</java.version>
    <fastddd.version>1.0.0-jdk21-SNAPSHOT</fastddd.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.gallop.fastddd</groupId>
        <artifactId>fastddd-bom</artifactId>
        <version>${fastddd.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- 聚合 starter：显式含 druid-spring-boot-3-starter（ECO-006C4），不另行选池 -->
    <dependency>
      <groupId>com.gallop.fastddd</groupId>
      <artifactId>fast-ddd-starter</artifactId>
    </dependency>
    <!-- 显式引入 web 的 optional 依赖，使 GlobalExceptionHandler 引用的 CommandValidationException 可解析 -->
    <dependency>
      <groupId>com.gallop.fastddd</groupId>
      <artifactId>fast-ddd-application</artifactId>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- 消费者侧 PO 使用 Lombok（真实消费项目自带，框架不传递） -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
