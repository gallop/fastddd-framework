<?xml version="1.0" encoding="UTF-8"?>
<!--
  FRM-002 验收场景②：复现审计 P0-2——Web 缺 application 的当前失败。
  消费者依赖 fast-ddd-starter（传递 web/crud），但【不】显式引入 fast-ddd-application。
  web 的 GlobalExceptionHandler 硬引用 application 的 CommandValidationException（optional），
  在 application 缺席时上下文启动抛 ClassNotFoundException/NoClassDefFoundError。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>
  <groupId>com.gallop.fastddd.consumer</groupId>
  <artifactId>web-without-application</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <name>FastDDD Consumer :: Web Without Application (P0-2 reproduction)</name>

  <properties>
    <java.version>21</java.version>
    <fastddd.version>1.0.0-jdk21-SNAPSHOT</fastddd.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.gallop.fastddd</groupId>
        <artifactId>fastddd-bom</artifactId>
        <version>${fastddd.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>com.gallop.fastddd</groupId>
      <artifactId>fast-ddd-starter</artifactId>
    </dependency>
    <!-- 故意不引入 fast-ddd-application：复现 GlobalExceptionHandler 对 optional 类的硬引用 -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
