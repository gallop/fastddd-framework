<?xml version="1.0" encoding="UTF-8"?>
<!--
  WEB-001 正向验收场景：fast-ddd-web 在无 fast-ddd-application 时可启动。
  消费者依赖 fast-ddd-starter（传递 web/crud），但【不】显式引入 fast-ddd-application。
  历史（FRM-002）此处复现 P0-2——GlobalExceptionHandler 硬引用 application 的
  CommandValidationException（optional），缺席时启动失败。WEB-001 已将 CQRS 异常处理抽离至
  CqrsExceptionAdvice（@ConditionalOnClass(CommandValidationException.class)），
  GlobalExceptionHandler 不再引用 application 包，context 正常启动（WebWithoutAppStartsTest）。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>
  <groupId>com.gallop.fastddd.consumer</groupId>
  <artifactId>web-without-application</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <name>FastDDD Consumer :: Web Without Application (WEB-001 acceptance)</name>

  <properties>
    <java.version>21</java.version>
    <fastddd.version>1.0.0-jdk21-SNAPSHOT</fastddd.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.gallop.fastddd</groupId>
        <artifactId>fastddd-bom</artifactId>
        <version>${fastddd.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>com.gallop.fastddd</groupId>
      <artifactId>fast-ddd-starter</artifactId>
    </dependency>
    <!-- 故意不引入 fast-ddd-application：复现 GlobalExceptionHandler 对 optional 类的硬引用 -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
