<?xml version="1.0" encoding="UTF-8"?>
<!-- W2-2 真实联调推进（修复轮）：真实飞书坐标的消费者冒烟场景。
     名称刻意不匹配 consumer-tests 的 invoker.test 自动包含模式（identity-* 等）——
     只经显式 -Dinvoker.test=live-identity-feishu 运行；无 FEISHU_LIVE_* 环境变量时
     测试全部禁用（@EnabledIfEnvironmentVariable），场景构建恒绿、不计入常规门禁。
     凭据只经环境变量进入测试 JVM（@DynamicPropertySource），不写入任何仓库文件。 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>
  <groupId>com.gallop.fastddd.consumer</groupId>
  <artifactId>live-identity-feishu</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <name>FastDDD Consumer :: Identity Feishu LIVE smoke (opt-in)</name>

  <properties>
    <java.version>21</java.version>
    <fastddd.version>1.0.0-SNAPSHOT</fastddd.version>
    <!-- ECO-RELEASE-04/S3 安全覆盖：tomcat-embed CVE-2026-65905/65182/68525（3×CRITICAL，10.1.x 线 fix 实际发布 10.1.59）。 -->
    <tomcat.version>10.1.59</tomcat.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.github.gallop.fastddd</groupId>
        <artifactId>fastddd-bom</artifactId>
        <version>${fastddd.version}</version>
        <type>pom</type><scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>io.github.gallop.fastddd</groupId>
      <artifactId>fast-ddd-identity-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.gallop.fastddd</groupId>
      <artifactId>fast-ddd-identity-reference-pg</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.gallop.fastddd</groupId>
      <artifactId>fast-ddd-identity-feishu</artifactId>
    </dependency>
    <!-- 宿主旧安全装配显式退让（jwt/local-auth=false）后仍留在 classpath（与 C 模式宿主同构） -->
    <dependency>
      <groupId>io.github.gallop.fastddd</groupId>
      <artifactId>fast-ddd-security-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.gallop.fastddd</groupId>
      <artifactId>fast-ddd-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId><artifactId>spring-security-test</artifactId><scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.zonky.test</groupId><artifactId>embedded-postgres</artifactId><version>2.0.7</version><scope>test</scope>
    </dependency>
  </dependencies>
</project>
