<?xml version="1.0" encoding="UTF-8"?>
<!-- ECO-RELEASE-08 A2：RocketMQ 三情形验收消费者（成功投递 / 发送失败重试 / 消费失败与死信）。
     依赖 RELEASE-05 固定候选（fastddd-bom 1.0.0-jdk21-SNAPSHOT → 20260907.214530-1 快照，
     经 settings.xml 候选仓 profile 解析，实跑前清 local repo com/gallop/fastddd 防陈旧混入）。
     依赖形态沿用 ECO-006C6 event-outbox 场景：event 池中立 → 消费者显式 starter-jdbc +
     测试域 H2 + 自备 outbox_events DDL + 显式 jsr310（非 web ObjectMapper 契约）。 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.gallop.fastddd.consumer</groupId>
  <artifactId>event-rocketmq-e2e</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <name>FastDDD Consumer :: Event RocketMQ E2E (A2 three scenarios)</name>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <fastddd.version>1.0.0-SNAPSHOT</fastddd.version>
    <maven.test.failure.ignore>false</maven.test.failure.ignore>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.github.gallop.fastddd</groupId>
        <artifactId>fastddd-bom</artifactId>
        <version>${fastddd.version}</version>
        <type>pom</type><scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>io.github.gallop.fastddd</groupId>
      <artifactId>fast-ddd-event</artifactId>
    </dependency>
    <!-- RocketMQ 客户端（版本经 fastddd-bom 受管 2.2.3；event 内为 optional 不传递，消费者显式选择） -->
    <dependency>
      <groupId>org.apache.rocketmq</groupId>
      <artifactId>rocketmq-spring-boot-starter</artifactId>
    </dependency>
    <!-- 消费者显式提供连接池（C6 后 event 池中立） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <!-- 测试域嵌入式库（MySQL 兼容模式）：消费者自备 DDL -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- 非 web outbox 消费者契约（ECO-006C6 实证）：TransactionalEventPublisher 序列化与
         rocketmq-spring 消息转换均需 JSR310（LocalDateTime）；版本经 Boot parent 受管 -->
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
