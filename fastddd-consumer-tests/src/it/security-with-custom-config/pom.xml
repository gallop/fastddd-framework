<?xml version="1.0" encoding="UTF-8"?>
<!--
  SEC-003 验收场景：业务自定义 SecurityFilterChain / PasswordEncoder / CurrentUserProvider
  与框架 security starter 共存时，框架应退让、不覆盖业务 Bean。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>
  <groupId>com.gallop.fastddd.consumer</groupId>
  <artifactId>security-with-custom-config</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <name>FastDDD Consumer :: Security With Custom Config</name>

  <properties>
    <java.version>21</java.version>
    <fastddd.version>1.0.0-jdk21-SNAPSHOT</fastddd.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.gallop.fastddd</groupId>
        <artifactId>fastddd-bom</artifactId>
        <version>${fastddd.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>com.gallop.fastddd</groupId>
      <artifactId>fast-ddd-security-starter</artifactId>
    </dependency>
    <!-- fast-ddd-crud: 提供 CurrentUserProvider SPI（security 通过 @ConditionalOnClass 桥接） -->
    <dependency>
      <groupId>com.gallop.fastddd</groupId>
      <artifactId>fast-ddd-crud</artifactId>
    </dependency>
    <dependency>
      <groupId>com.gallop.fastddd</groupId>
      <artifactId>fast-ddd-application</artifactId>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
