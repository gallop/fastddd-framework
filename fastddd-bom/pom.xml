<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        FastDDD BOM —— 面向业务系统的统一依赖契约入口。
        业务项目只需在 dependencyManagement 中 import 本 BOM，即可获得 FastDDD 全部模块与
        推荐第三方依赖的一致版本，无需各自声明版本。

        设计：本 BOM 为【独立 POM】（不继承根 pom 作为 parent），自行声明 depMgmt 所需的
        版本属性，确保【发布 BOM 完全自洽】——不泄漏根 pom 的 profile/数据库/Redis 等环境属性。
        自模块版本统一使用 ${project.version}，避免消费方自己的 revision 属性覆盖 BOM 内版本；
        发布时由 flatten-maven-plugin (bom 模式) 保留 depMgmt、移除 parent。
        （reactor 内 27 个模块仍用根 pom 的 resolveCiFriendliesOnly，仅 BOM 例外。）
    -->
    <groupId>io.github.gallop.fastddd</groupId>
    <artifactId>fastddd-bom</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <name>FastDDD BOM</name>
    <description>FastDDD 统一依赖契约入口：聚合 framework 全部模块版本，业务项目 import 此 BOM 即获得一致依赖版本</description>
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <!-- Maven Central 发布校验强制项（BOM 无 parent，元数据须自持，与根 pom 对齐） -->
    <url>https://github.com/gallop/fastddd-framework</url>
    <scm>
        <connection>scm:git:https://github.com/gallop/fastddd-framework.git</connection>
        <developerConnection>scm:git:git@github.com:gallop/fastddd-framework.git</developerConnection>
        <url>https://github.com/gallop/fastddd-framework</url>
    </scm>
    <organization>
        <name>gallop-group</name>
    </organization>
    <developers>
        <developer>
            <id>gallop</id>
            <name>Gallop</name>
            <email>39100782@qq.com</email>
        </developer>
    </developers>
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- CI-friendly 版本（与根 pom 一致，BOM 无 parent 须手工同步；发布可用 -Drevision=1.1.0-M1 覆盖） -->
        <revision>1.1.0-SNAPSHOT</revision>
        <!-- 仅声明 depMgmt 所需版本属性（与根 pom 对齐），不继承根 pom 的环境/profile 属性 -->
        <spring-boot.version>3.5.16</spring-boot.version>
        <!-- ECO-RELEASE-04 (A1)：Tomcat 安全修复覆盖（Boot 3.5.16 受管 10.1.55 → 10.1.59）。
             依据：Apache 官方安全页 CVE-2026-65905(Low)/65182(Important)/68525(Low) 均 Fixed in 10.1.59；
             10.1.58 从未发布（Maven Central 无该版本）。Boot 3.5.x 无携带修复版的补丁版（最新即 3.5.16），
             故以 BOM 显式条目覆盖（直接声明条目优先于 import 引入的受管项，与声明顺序无关）。
             仅覆盖消费者实际解析的 embed 三件套；tomcat-jdbc/jsp-api/jasper 不在传递面，保留 Boot 受管值。 -->
        <tomcat-embed.version>10.1.59</tomcat-embed.version>
        <spring-ai.version>1.1.8</spring-ai.version>
        <mybatis-plus.version>3.5.12</mybatis-plus.version>
        <mybatis-spring.version>3.0.4</mybatis-spring.version>
        <druid.version>1.2.28</druid.version>
        <rocketmq.version>2.2.3</rocketmq.version>
        <elasticsearch.version>8.11.0</elasticsearch.version>
        <springdoc.version>2.8.17</springdoc.version>
        <knife4j.version>4.5.0</knife4j.version>
        <hutool.version>5.8.34</hutool.version>
        <mapstruct.version>1.5.5.Final</mapstruct.version>
        <javaparser.version>3.25.1</javaparser.version>
        <jjwt.version>0.11.5</jjwt.version>
        <zip4j.version>2.11.5</zip4j.version>
        <logstash-logback-encoder.version>7.4</logstash-logback-encoder.version>
        <flatten-maven-plugin.version>1.6.0</flatten-maven-plugin.version>
        <!-- Central 发布链插件版本自持（BOM 无 parent，继承不到根 pom properties；与根 pom 对齐） -->
        <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
        <central-publishing-maven-plugin.version>0.12.0</central-publishing-maven-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- ============ Tomcat 安全修复覆盖（ECO-RELEASE-04/A1） ============
                 直接声明的受管条目优先于 import 引入的受管项（与声明顺序无关，实测
                 framework/tooling 两 reactor 与 import 形态消费者均解析 10.1.59）；
                 属性覆盖对 import 的 BOM 无效（其 ${tomcat.version} 已在 Boot 自身模型解析为字面量 10.1.55），
                 故以显式受管条目钉版本。注意：parent=spring-boot-starter-parent 的消费者，其继承 dm
                 优先于本 BOM 的 import 条目——此类消费者须自行声明 <tomcat.version> 属性（见
                 consumer-tests 各场景 pom 与 REMEDIATION 文档迁移说明）。 -->
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-core</artifactId>
                <version>${tomcat-embed.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-el</artifactId>
                <version>${tomcat-embed.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-websocket</artifactId>
                <version>${tomcat-embed.version}</version>
            </dependency>
            <!-- ============ 上游 BOM（优先级最高，置于最前） ============ -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- ============ FastDDD 自模块（始终随 BOM 自身 project.version） ============ -->
            <dependency>
                <groupId>io.github.gallop.fastddd</groupId>
                <artifactId>fast-ddd-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.gallop.fastddd</groupId>
                <artifactId>fast-ddd-config</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.gallop.fastddd</groupId>
                <artifactId>fast-ddd-model</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.gallop.fastddd</groupId>
                <artifactId>fast-ddd-crud</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.gallop.fastddd</groupId>
                <artifactId>fast-ddd-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.gallop.fastddd</groupId>
                <artifactId>fast-ddd-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.gallop.fastddd</groupId>
                <artifactId>fast-ddd-cache</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.gallop.fastddd</groupId>
                <artifactId>fast-ddd-event</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.gallop.fastddd</groupId>
                <artifactId>fast-ddd-search</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.gallop.fastddd</groupId>
                <artifactId>fast-ddd-monitor</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.gallop.fastddd</groupId>
                <artifactId>fast-ddd-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.gallop.fastddd</groupId>
                <artifactId>fast-ddd-analyzer-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.gallop.fastddd</groupId>
                <artifactId>fast-ddd-security-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.gallop.fastddd</groupId>
                <artifactId>fast-ddd-ai-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- 身份域（W2-1，v0.2 §3）：纯 Java 核心 / PG 参考适配 / Spring Boot starter -->
            <dependency>
                <groupId>io.github.gallop.fastddd</groupId>
                <artifactId>fast-ddd-identity-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.gallop.fastddd</groupId>
                <artifactId>fast-ddd-identity-reference-pg</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.gallop.fastddd</groupId>
                <artifactId>fast-ddd-identity-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- 身份域（W2-2）：飞书适配（OAuth 2.0 + PKCE 真实提供者，独立可选） -->
            <dependency>
                <groupId>io.github.gallop.fastddd</groupId>
                <artifactId>fast-ddd-identity-feishu</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- ============ 第三方受管依赖（与根 pom dependencyManagement 对齐） ============ -->
            <!-- Database -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!-- ECO-006C4：Web/CRUD 依赖边界整改——web-nodb 需要 MP 能力但不强制 JDBC 池。
                 starter（含 spring-boot-starter-jdbc→HikariCP）拆解为以下构件，供模块按需声明：
                 bundle（core+extension+spring+mybatis）、core/extension（签名级引用）、
                 autoconfigure（MybatisPlusAutoConfiguration，无池实现时按 @ConditionalOnSingleCandidate(DataSource) 退让）。
                 注意：mybatis-spring 在 bundle 内为 optional，使用方须显式声明（BOM 已受管 3.0.4）。 -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-core</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-extension</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot-autoconfigure</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!-- ECO-006C2：security-starter 审计实体仅用 MP 注解，改传递最小注解构件（不引入自动配置/JDBC 池链） -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-annotation</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-generator</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mybatis</groupId>
                <artifactId>mybatis-spring</artifactId>
                <version>${mybatis-spring.version}</version>
            </dependency>
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>druid-spring-boot-3-starter</artifactId>
                <version>${druid.version}</version>
            </dependency>
            <!-- Message Queue -->
            <dependency>
                <groupId>org.apache.rocketmq</groupId>
                <artifactId>rocketmq-spring-boot-starter</artifactId>
                <version>${rocketmq.version}</version>
            </dependency>
            <!-- Search -->
            <dependency>
                <groupId>co.elastic.clients</groupId>
                <artifactId>elasticsearch-java</artifactId>
                <version>${elasticsearch.version}</version>
            </dependency>
            <!-- Documentation -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.xiaoymin</groupId>
                <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
                <version>${knife4j.version}</version>
            </dependency>
            <!-- Utilities -->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct-processor</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.javaparser</groupId>
                <artifactId>javaparser-core</artifactId>
                <version>${javaparser.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.javaparser</groupId>
                <artifactId>javaparser-symbol-solver-core</artifactId>
                <version>${javaparser.version}</version>
            </dependency>
            <!-- Security -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <!-- Utilities (additional) -->
            <dependency>
                <groupId>net.lingala.zip4j</groupId>
                <artifactId>zip4j</artifactId>
                <version>${zip4j.version}</version>
            </dependency>
            <!-- Logging -->
            <dependency>
                <groupId>net.logstash.logback</groupId>
                <artifactId>logstash-logback-encoder</artifactId>
                <version>${logstash-logback-encoder.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- 发布 BOM 字面量化：bom 模式保留 dependencyManagement + properties、移除 parent，
                 产出完全自洽的发布 BOM（无环境属性泄漏）。 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>${flatten-maven-plugin.version}</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>bom</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- Central 发布链自持（BOM 无 parent，继承不到根 pom 的 central profile）：
         与根 pom 同名同款 profile，由 CI 统一 -Pcentral 激活。
         gpg：为 BOM pom 产出 .asc 签名（Portal 校验每件构件均须签名）；
         central-publishing（extensions=true）：使 BOM 获得 injected-central-publishing
         deploy 执行——BOM 为 reactor 最后一个带该插件的模块，bundle 打包+上传在此发生，
         BOM 由此进入发布 bundle。autoPublish=false 保持人工发布核对门。 -->
    <profiles>
        <profile>
            <id>central</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>${maven-gpg-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                            </gpgArguments>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>${central-publishing-maven-plugin.version}</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>false</autoPublish>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
