<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.gallop.fastddd</groupId>
        <artifactId>fastddd-framework-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>fast-ddd-identity-core</artifactId>
    <name>fast-ddd-identity-core</name>
    <description>FastDDD Identity Core - pure-Java identity domain: principal value objects, ports and use cases (no Spring, no Feishu SDK)</description>

    <!-- 契约约束（v0.2 §3）：本模块为纯 Java——不依赖 Spring、飞书 SDK、FastAgent；
         starter/feishu/reference-pg 依赖本模块，本模块不依赖任何 FastDDD 模块。 -->

    <dependencies>
        <!-- Test Dependencies -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- W7-d / D-7 = (A)：TCK 以 test-jar classifier 附属于本坐标（版本继承父 pom pluginManagement，
         不带版本号；现有测试类随 test-jar 一并打包属 (A) 形态正常）。
         P-6（T8.98 拍板=条件化排除）：profile 默认激活（属性 skip-tests-jar 不在时）——reactor
         内 TCK dogfood 照常产出；候选构建传 -Dskip-tests-jar 跳过 test-jar goal，发布候选仓
         维持 M2 288 文件形。 -->
    <profiles>
        <profile>
            <id>tests-jar-default</id>
            <activation>
                <property>
                    <name>!skip-tests-jar</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>test-jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
