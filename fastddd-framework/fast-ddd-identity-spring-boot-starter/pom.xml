<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.gallop.fastddd</groupId>
        <artifactId>fastddd-framework-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>fast-ddd-identity-spring-boot-starter</artifactId>
    <name>fast-ddd-identity-spring-boot-starter</name>
    <description>FastDDD Identity Spring Boot Starter - C-mode session security chain, W1-b assembly guards, Actor bridge and Spring transaction runner for fast-ddd-identity-core</description>

    <!-- 契约约束（v0.2 §3/§4）：依赖 identity-core + Spring 装配件；
         不依赖 reference-pg（宿主/引用适配器按需引入），不依赖飞书 SDK（W2-2 交付适配）。 -->

    <dependencies>
        <dependency>
            <groupId>io.github.gallop.fastddd</groupId>
            <artifactId>fast-ddd-identity-core</artifactId>
        </dependency>

        <!-- 装配/属性绑定 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <!-- 事务桥接：JDBC 绑定 DataSourceTransactionManager（spring-tx 随 spring-jdbc 传递） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
        </dependency>

        <!-- C 模式会话过滤链（Worker 场景携带 jar 但不装配链） -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-config</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-web</artifactId>
        </dependency>

        <!-- 会话过滤器/工具类（Web 环境必有；optional 不强制 Worker 消费者引入） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- CRUD CurrentUserProvider 桥接（IdentityCurrentUserProvider，§4.5 显式顺序优先） -->
        <dependency>
            <groupId>io.github.gallop.fastddd</groupId>
            <artifactId>fast-ddd-crud</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Test Dependencies -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- C 双开关/W1-a 门控交互与旧路由旁路断言需要 security-starter 在 classpath -->
        <dependency>
            <groupId>io.github.gallop.fastddd</groupId>
            <artifactId>fast-ddd-security-starter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 引用 PG 适配（真实端口联装；staging 场景同 consumer identity-session-postgres） -->
        <dependency>
            <groupId>io.github.gallop.fastddd</groupId>
            <artifactId>fast-ddd-identity-reference-pg</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.zonky.test</groupId>
            <artifactId>embedded-postgres</artifactId>
            <version>2.0.7</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
